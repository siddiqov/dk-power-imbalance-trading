# Supabase Configuration (Python publisher)
# Copy this file to .env and fill in your Supabase credentials
# Get these from: Supabase Dashboard → Settings → API

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Use the SERVICE ROLE key (not anon key) for the Python publisher
# because it needs INSERT/UPDATE permissions.
# The anon key is used by the React frontend (read-only).
